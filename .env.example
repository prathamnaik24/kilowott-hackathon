# --- Server ---
PORT=4000
PUBLIC_URL=http://localhost:4000
DATABASE_URL=file:./dev.db
JWT_SECRET=change-me-in-production

# --- WooCommerce ---
# Leave WOO_STORE_URL empty to use the built-in mock store at /mock-woo.
WOO_STORE_URL=
WOO_CONSUMER_KEY=ck_mock
WOO_CONSUMER_SECRET=cs_mock
# Must match the "Secret" field of the webhooks you create in WooCommerce.
WOO_WEBHOOK_SECRET=woopulse-webhook-secret
MOCK_WOO_ENABLED=true
AUTO_SYNC_ON_BOOT=true

# --- AI (any OpenAI-compatible endpoint) ---
# Groq (free): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Ollama alternative: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1

# --- Demo login ---
ADMIN_EMAIL=admin@woopulse.dev
ADMIN_PASSWORD=demo1234
